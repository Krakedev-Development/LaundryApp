# Token público móvil, sin restricciones de URL. No usar tokens secretos.
EXPO_PUBLIC_MAPBOX_TOKEN=
EXPO_PUBLIC_GEO_MODE=demo
# Activar solamente cuando la cuenta permita geocodificación permanente.
EXPO_PUBLIC_MAPBOX_PERMANENT_GEOCODING=false
EXPO_PUBLIC_APP_COUNTRY=EC
EXPO_PUBLIC_APP_MAP_LANGUAGE=es
EXPO_PUBLIC_APP_DEFAULT_LATITUDE=-2.124
EXPO_PUBLIC_APP_DEFAULT_LONGITUDE=-79.869
EXPO_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12
EXPO_PUBLIC_TRACKING_MODE=mock
EXPO_PUBLIC_USE_BACKEND_GEO=false
EXPO_PUBLIC_GEO_API_URL=
