{
  "expo": {
    "name": "Laundry Clean & Fresh",
    "slug": "laundry-clean-fresh",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#143F73"
      },
      "package": "com.laundryfresh.app"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#143F73",
          "image": "./assets/logo-laundry-lav.png",
          "imageWidth": 140
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite seleccionar imágenes para verificar tu identidad o registrar una entrega.",
          "cameraPermission": "Permite tomar fotos para verificar tu identidad o registrar una entrega.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite usar tu ubicación para navegar tus servicios asignados."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permite usar la cámara para verificar códigos de transferencia.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "scheme": "laundryfresh",
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
