{
  "expo": {
    "name": "Laundry Clean & Fresh",
    "slug": "LaundryApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "scheme": "laundryapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aistudio.applet.mpsvkf"
    },
    "android": {
      "package": "com.aistudio.applet.mpsvkf",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-laundry.png",
        "backgroundColor": "#143F73"
      }
    },
    "web": { "bundler": "metro", "favicon": "./assets/icono-App.png" },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-laundry-lav.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Laundry necesita acceso a las fotos que elijas para documentos y evidencias.",
          "cameraPermission": "Laundry necesita la cámara para capturar tu verificación y evidencias.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Laundry necesita la cámara para leer los códigos de transferencia.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font"
    ]
  }
}
