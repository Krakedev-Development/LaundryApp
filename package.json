{
  "name": "laundryapp",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "tsx tests/fixtures/exportSeed.ts && playwright test",
    "preview:mvp": "node scripts/preview-export.cjs",
    "export:android": "expo export --platform android --max-workers 2 --output-dir dist-android",
    "export:web": "expo export --platform web --max-workers 2",
    "doctor": "expo-doctor",
    "check:shared-login": "node scripts/check-shared-login.cjs"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@expo/vector-icons": "^15.0.2",
    "@laundry/mobile-auth": "file:packages/mobile-auth",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "expo": "~58.0.23",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.3",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "expo-doctor": "^1.17.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@10.30.3"
}
